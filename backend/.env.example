# ─── Server ───────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ─── Database ─────────────────────────────────────────
DB_PATH=./neonbench.db

# ─── AI Agent ─────────────────────────────────────────
AI_PROVIDER=openai
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-4

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
